/* Original wave equations: Lukas Tenbrink / Sollace. Native coordinates adapted for Forge. */
uniform float PS_Enabled;
uniform sampler2D PS_SurfaceFractalSampler;
uniform vec4 PS_SurfaceFractalCoords;
uniform float PS_SurfaceFractalStrength;
uniform vec3 PS_CameraPosition;
uniform mat4 PS_ViewToWorld;
uniform float PS_PulseShape;
out vec3 PS_SurfaceColor;
out float PS_PulseDistance;
__PS_DEFORMATION__
void main() {
  psychedelicraft_parent_main();
  PS_SurfaceColor = vec3(0.0);
  PS_PulseDistance = 0.0;
  if (PS_Enabled <= 0.0) return;
  vec3 view = __PS_VIEW_POSITION__;
  vec3 relative = (PS_ViewToWorld * vec4(view, 1.0)).xyz;
  vec3 position = relative + PS_CameraPosition;
  if (PS_PulseShape == 1.0) PS_PulseDistance = length(view);
  // Model and terrain bands share world up; only spherical fog uses radial distance.
  else if (PS_PulseShape > 1.0) PS_PulseDistance = max(length(relative.xz), abs(relative.y));
  if (PS_SurfaceFractalStrength > 0.0) {
    vec2 uv = mod(position.xz + position.yy, 4.0) / 4.0;
    PS_SurfaceColor = texture(PS_SurfaceFractalSampler, mix(PS_SurfaceFractalCoords.xy, PS_SurfaceFractalCoords.zw, uv)).rgb;
    __PS_SURFACE_COLOR__
  }
  gl_Position = psychedelicraft_deform(gl_Position, position, length(view), length(relative.xz));
}
