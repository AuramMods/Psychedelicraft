uniform vec4 PS_SurfaceFractalCoords;
uniform float PS_SurfaceFractalStrength;
uniform float PS_PulseShape;
out vec3 PS_SurfaceColor;
out float PS_PulseDistance;

void main() {
  psychedelicraft_parent_main();
  PS_SurfaceColor = vec3(0.0);
  PS_PulseDistance = 0.0;
  if (PS_Enabled <= 0.0) return;
  vec3 relative = __PS_TERRAIN_POSITION__;
  if (PS_PulseShape == 1.0) PS_PulseDistance = length(relative);
  else if (PS_PulseShape > 1.0) PS_PulseDistance = max(length(relative.xz), abs(relative.y));
  if (PS_SurfaceFractalStrength > 0.0) {
    vec3 position = relative + PS_CameraPosition;
    vec2 uv = mod(position.xz + position.yy, 4.0) / 4.0;
    PS_SurfaceColor = texture(__PS_ATLAS__, mix(PS_SurfaceFractalCoords.xy, PS_SurfaceFractalCoords.zw, uv)).rgb;
    color.rgb = mix(color.rgb, PS_SurfaceColor, PS_SurfaceFractalStrength);
  }
}
